[
  {"id":"things-prev-or","file":"Things.lean","before":"shares r q && may r q","after":"shares r q || may r q","reason":"Allow either entitlement condition."},
  {"id":"things-drop-may","file":"Things.lean","before":"shares r q && may r q","after":"(fun _ => shares r q) may","reason":"Ignore the store rule."},
  {"id":"things-drop-erasure","file":"Things.lean","before":"if erasedIn xs i then r.erase else r","after":"r","reason":"Ignore settled erasure."},
  {"id":"fold-drop-prev-filter","file":"Fold.lean","before":"s.heads.filter (fun h => !r.prev.contains h.id)","after":"s.heads","reason":"Keep replaced heads."},
  {"id":"fold-drop-named-guard","file":"Fold.lean","before":"if named.contains r.id then heads else insertRec r heads","after":"insertRec r heads","reason":"Insert previously named records."},
  {"id":"spec-unread-duplicates","file":"Spec.lean","before":"(idsOf unknown).length","after":"unknown.length","reason":"Count duplicate unread records."},
  {"id":"spec-below-time-inclusive","file":"Spec.lean","before":"decide (s.start < c.span.start)","after":"decide (s.start ≤ c.span.start)","reason":"Include the boundary."},
  {"id":"spec-atleast-time-strict","file":"Spec.lean","before":"decide (c.span.start ≤ s.start)","after":"decide (c.span.start < s.start)","reason":"Exclude the boundary."},
  {"id":"spec-source-all-any","file":"Spec.lean","before":"s.about.all r.isAbout","after":"s.about.any r.isAbout","reason":"Reject an empty source selection."},
  {"id":"families-unknown-no","file":"Families.lean","before":"| .payload t, r => if r.shown = .here then .ofBool (t r) else .unknown","after":"| .payload t, r => if r.shown = .here then .ofBool (t r) else .no","reason":"Treat hidden payloads as no."},
  {"id":"families-drop-readable","file":"Families.lean","before":"f.fold (ys.filter f.readable)","after":"f.fold ys","reason":"Fold unreadable records."},
  {"id":"families-unread-zero","file":"Families.lean","before":"(xs.filter (ev · == .unknown)).length + (ys.filter (!f.readable ·)).length","after":"0","reason":"Discard unread counts."},
  {"id":"things-here-last","file":"Things.lean","before":"forms.find? (·.shown == .here)","after":"forms.reverse.find? (·.shown == .here)","reason":"Prefer the last here form."},
  {"id":"things-no-self-anchor","file":"Things.lean","before":"if r.about.isEmpty then [idText r.id] else r.about","after":"if r.about.isEmpty then [] else r.about","reason":"Drop the self anchor."},
  {"id":"things-negate-erases","file":"Things.lean","before":"e.erases.contains i","after":"!e.erases.contains i","reason":"Invert erasure membership."},
  {"id":"fold-winner-last","file":"Fold.lean","before":"def LatestBy.winner (s : LatestBy) : Option Record := s.heads.head?","after":"def LatestBy.winner (s : LatestBy) : Option Record := s.heads.getLast?","reason":"Choose the oldest head."},
  {"id":"fold-insert-nonstrict","file":"Fold.lean","before":"if n < m then n :: m :: ms","after":"if n ≤ m then n :: m :: ms","reason":"Insert equal ids twice."},
  {"id":"fold-count-zero","file":"Fold.lean","before":"def Count.step (n : Nat) (_ : Record) : Nat := n + 1","after":"def Count.step (n : Nat) (_ : Record) : Nat := n + 0","reason":"Do not increment counts."},
  {"id":"spec-drop-head-choice","file":"Spec.lean","before":"s.heads.filter (chosen sel cs)","after":"(let _ := sel; s.heads)","reason":"Keep unchosen heads."},
  {"id":"spec-drop-collect-choice","file":"Spec.lean","before":"newestFirst (pool.filter (chosen sel cs))","after":"newestFirst (let _ := sel; pool)","reason":"Keep unchosen records."},
  {"id":"spec-collect-unknown-yes","file":"Spec.lean","before":"limitTo limit (hs.filter (payTest cs · == .yes))","after":"limitTo limit (hs.filter (payTest cs · != .no))","reason":"Include unknown payload tests."},
  {"id":"spec-below-number-inclusive","file":"Spec.lean","before":"decide (j < i)","after":"decide (j ≤ i)","reason":"Include the number boundary."},
  {"id":"stored-salt-check","file":"Stored.lean","before":"if salt.length ≠ 16 then some \"salt-not-16-bytes\"","after":"if salt.length = 16 then some \"salt-not-16-bytes\"","reason":"Invert the salt check."},
  {"id":"stored-commit-order","file":"Stored.lean","before":"salt ++ utf8 payload.canon","after":"utf8 payload.canon ++ salt","reason":"Reverse commitment inputs."},
  {"id":"stored-refusal-last","file":"Stored.lean","before":"writeCodes.find? codes.contains","after":"writeCodes.reverse.find? codes.contains","reason":"Choose the last refusal."},
  {"id":"record-newer-id-flip","file":"Record.lean","before":"a.id > b.id","after":"a.id < b.id","reason":"Reverse the id tie break."},
  {"id":"record-num-hidden","file":"Record.lean","before":"if r.shown = .here then","after":"if True then","reason":"Read hidden numbers."},
  {"id":"occurred-month-end","file":"Occurred.lean","before":"1 ≤ d && d ≤ daysIn y m","after":"1 ≤ d && d < daysIn y m","reason":"Reject the last day."},
  {"id":"occurred-open-stop","file":"Occurred.lean","before":"| some _, none => True","after":"| some _, none => False","reason":"Reject an open stop."},
  {"id":"occurred-qualifier-and","file":"Occurred.lean","before":"c == '?' || c == '~' || c == '%'","after":"c == '?' && c == '~' || c == '%'","reason":"Require two qualifiers."},
  {"id":"record-num-drop-int","file":"Record.lean","before":"| some (.int i) => some i","after":"| some (.int _) => none","reason":"Use the default result for the integer match arm."}
]
